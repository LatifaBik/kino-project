
<h1 class="movie-detail">The movie detail</h1>

<a href="./" class="movie-back-link"> ← Back to movie site</a>



<article class="movie">
  <h1>{{ movie.title }}</h1>
 {{#if movie.intro}}
    <div class="intro">{{movie.intro}}</div>
  {{/if}}
  
  {{#if movie.image}}
  <img src="{{ movie.image.url }}">
    
  {{/if}}
</article> 


 