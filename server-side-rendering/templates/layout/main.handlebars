<!DOCTYPE html>
<html>

<head>
  <meta charset='utf-8'>
  <meta http-equiv='X-UA-Compatible' content='IE=edge'>
  <meta name='viewport' content='width=device-width, initial-scale=1'>
  <title>KINO _ Movie Theater</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/main.css">
</head>

<!-- Info / notice bar -->
<div class="notice" role="status" aria-live="polite">
  <p class="notice__text">Biljetter kan enbart köpas på biografen! <br> Välkommen till oss på Storgatan 12.</p>
  <span class="notice__hours">Öppettider: 08:00 – 22:00</span>
  <button class="notice__close" type="button" aria-label="Stäng notis">&times;</button>
</div>

<body>
<header class="header">

  {{!-- MENY-knapp --}}
  <button
    id="{{menuToggle.id}}"
    data-action="{{menuToggle.action}}"
    class="header__menu-button">
    ☰ {{menuToggle.label}}
  </button>

  {{!-- LOGO --}}
<a href="{{logo.href}}" class="header__logo-dark">
  <img src="/assets/logo1-dark.png" alt="{{logo.alt}}">
</a>

<a href="{{logo.href}}" class="header__logo-light">
  <img src="/assets/logo2-light.png" alt="{{logo.alt}}">
</a>


  {{!-- HÖGER: knappar + theme --}}
  <div class="header-right">

    {{#each buttons}}
      <button
        id="{{id}}"
        data-action="{{action}}"
        data-target="{{target}}">
        
        {{label}}
      </button>
    {{/each}}

    {{!-- THEME toggle --}}
    <button
      id="{{themeToggle.id}}"
      data-action="{{themeToggle.action}}"
      aria-label="{{themeToggle.alt}}">

      {{#if isDark}}
        <img src="{{themeToggle.icon.dark}}" alt="{{themeToggle.alt}}">
      {{else}}
        <img src="{{themeToggle.icon.light}}" alt="{{themeToggle.alt}}">
      {{/if}}

    </button>

  </div>
</header>



 <footer>
    <section class="footer__container">
      <section class="footer__content">
        <div class="footer__section footer__section--about">
          <div class="footer__about"></div>
          <h3>Om oss</h3>
          <ul class="footer__links">
            <li><a href="#">Jobba hos oss</a></li>
            <li><a href="#">Press</a></li>
            <li><a href="#">Om Kino</a></li>
            <li><a href="#">Filmfestivalen</a></li>
            <li><a href="#">Hitta hit</a></li>
          </ul>
        </div>

        <div class="footer__section footer__section--other">
          <div class="footer__other"></div>
          <h3>Övrigt</h3>
          <ul class="footer__terms">
            <li><a href="#">Köpvilkor</a></li>
            <li><a href="#">Integritetspolicy</a></li>
            <li><a href="#">Åldersgränser</a></li>
            <li><a href="#">Tillgänglighet</a></li>
          </ul>
        </div>

        <div class="footer__section footer__section--contact">
          <div class="footer__contact"></div>
          <h3>Hjälp & Kontakt</h3>
          <ul class="footer__info">
            <li><i class="fas fa_map_marker_alt"></i> <a
                href="https://maps.google.com/?q=Storgatan 12, 123 45 Lycksele">Storgatan 12, 123 45
                Lycksele</a></li>
            <li><i class="fas fa_phone"></i> <a href="tel:+46950xxxxxxxx">+46 950-xxxxxxxx</a></li>
            <li><i class="fas fa_envelope"></i> <a href="mailto:info@kino.com">info@kino.com</a></li>
          </ul>
        </div>

        <div class="footer__section footer__section--social">
          <div class="footer__social"></div>
          <h3>Sociala medier</h3>
          <div class="footer__icons">
            <div class="social">
              <a href="#" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
              <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
              <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
            </div>
          </div>
        </div>

        <div class="footer__section footer__section--extra">
          <div class="footer__extra">
            <div class="footer__row">
              <div class="newsletter">
                <h3 class="newsletter__title">Nyhetsbrev</h3>
                <input class="newsletter__input" type="email" placeholder="you@example.com">
                <button class="newsletter__submit" type="submit">Anmäl dig</button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </section>
  </footer>
  
  <!--TRAILER MODAL-->
  <div id="trailerModal" class="trailer-modal hidden">
    <div class="trailer-modal__backdrop"></div>
    <div class="trailer-modal__content">
      <button class="trailer-modal__close" type="button">✕</button>

      <iframe id="trailerIframe" width="100%" height="450" src="" frameborder="0" allow="autoplay; encrypted-media"
        allowfullscreen>
      </iframe>
    </div>
  </div>
  
  <script type="module" src="/src/index.js"></script>
</body>
</html>


