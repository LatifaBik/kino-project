

<a href="/" class="movies-back-link">← Back to front site</a>

<p class="movies-intro">Select a movie to view details</p>

<ul class="movies-list">
  {{#each movies}}
    <li class="movies-list__item">
      <a
        href="/movies/{{ this.id }}"
        class="movies-list__link"
      >
        {{ this.title }}
      </a>
    </li>
  {{/each}}
</ul>


